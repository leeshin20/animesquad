{
  "manifest_version": 3,
  "name": "AnimeSquad",
  "version": "1.0.0",
  "description": "넷플릭스, 라프텔, 크런치롤에서 애니 시청 기록을 animesquad에 남기세요.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.animesquad.me/*"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://laftel.net/*",
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "content/parsers.js",
        "content/watch-detectors.js",
        "content/index.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
